{
  "//_comment": "大模型 API 配置。你只需要改这里的值，无需改代码。",
  "default_protocol": "siliconflow",
  "protocols": {
    "siliconflow": {
      "//_comment": "硅基流动 SiliconFlow，OpenAI 兼容。请求地址: POST https://api.siliconflow.cn/v1/chat/completions",
      "base_url": "https://api.siliconflow.cn/v1",
      "api_key": "你的SiliconFlow API Key",
      "model": "Pro/MiniMaxAI/MiniMax-M2.5",
      "timeout": 30000,
      "parameters": {
        "temperature": 0.7,
        "top_p": 0.7,
        "max_tokens": 4096
      }
    },
    "openai": {
      "//_comment": "兼容 OpenAI API 规范（/v1/chat/completions）。base_url 可以换成代理地址。",
      "base_url": "https://api.openai.com/v1",
      "api_key": "你的OpenAI API Key",
      "model": "gpt-3.5-turbo",
      "timeout": 10000,
      "parameters": {
        "temperature": 0.7,
        "top_p": 1.0,
        "max_tokens": 2048
      }
    },
    "anthropic": {
      "//_comment": "兼容 Anthropic API 规范（/v1/messages）。",
      "base_url": "https://api.anthropic.com/v1",
      "api_key": "你的Anthropic API Key",
      "model": "claude-3-haiku-20240307",
      "timeout": 10000,
      "parameters": {
        "temperature": 0.7,
        "max_tokens": 1024
      }
    }
  }
}
